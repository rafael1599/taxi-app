{
  "name": "drivly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @drivly/api dev\" \"pnpm --filter @drivly/admin dev\"",
    "driver": "pnpm --filter @drivly/driver start",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @drivly/db generate",
    "db:migrate": "pnpm --filter @drivly/db migrate",
    "db:seed": "pnpm --filter @drivly/db seed",
    "db:migrate-admins": "pnpm --filter @drivly/db migrate:admins",
    "db:migrate-price-overrides": "pnpm --filter @drivly/db migrate:price-overrides",
    "db:migrate-drivers": "pnpm --filter @drivly/db migrate:drivers",
    "lint": "eslint . --ext .ts,.tsx --ignore-path .gitignore",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
