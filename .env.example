# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ─── Twilio (SMS / OTP) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─── Expo Push ────────────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rockland_taxi

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-before-deploying
API_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Get from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
