# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# OSRM self-hosted instance (fallback when Google unavailable)
# OSRM_BASE_URL=https://router.project-osrm.org

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ─── WhatsApp Bot (OTP delivery — primary method) ────────────────────────────
# URL of the baileys WhatsApp bot service (e.g., http://localhost:3002)
# If set, OTP codes are sent via WhatsApp. If empty, falls back to Twilio or dev mode.
WHATSAPP_BOT_URL=
INTERNAL_API_SECRET=

# ─── Twilio (SMS / OTP — fallback/future) ────────────────────────────────────
# Only used if WHATSAPP_BOT_URL is not set
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─── Supabase (legacy — read-only during migration) ─────────────────────────
SUPABASE_DATABASE_URL=

# ─── Expo Push ────────────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drivly

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── App ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-before-deploying
API_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Get from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
